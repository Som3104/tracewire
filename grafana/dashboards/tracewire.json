              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Flows by service",
      "description": "",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
