    {
      "id": 5,
      "type": "timeseries",
      "title": "Flows per 10 seconds",
      "description": "",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "tracewire-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts, '10s'), count(*) AS \"Flows\"\nFROM flows WHERE $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8f9a98"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Attack flows flagged per 10 seconds, by engine",
      "description": "Ground truth is the number of attack flows that started in each 10-second bin; each engine line counts the flows it flagged.",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "tracewire-db"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts, '10s'),\n  count(*) FILTER (WHERE label <> 'benign') AS \"Ground truth\",\n  count(*) FILTER (WHERE sig_pred <> 'benign') AS \"Tracewire rules\",\n  count(*) FILTER (WHERE sur_pred IS NOT NULL AND sur_pred <> 'benign') AS \"Suricata\",\n  count(*) FILTER (WHERE rf_pred <> 'benign') AS \"Random forest\"\nFROM flows WHERE $__timeFilter(ts)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1.5,
            "fillOpacity": 0,
            "showPoints": "never",
            "drawStyle": "line"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Ground truth"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8f9a98"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tracewire rules"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c98500"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Suricata"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e3b04b"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Random forest"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2c93c0"
                }
              }
            ]
          }
        ]
      },
      "options": {
