    {
      "id": 11,
      "type": "table",
      "title": "Top talkers",
      "description": "Sorted by distinct ports: scanners float to the top even when they send few flows.",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "tracewire-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT src AS \"Source\", count(*) AS \"Flows\", count(DISTINCT dst) AS \"Hosts contacted\",\n  count(DISTINCT dport) AS \"Ports contacted\", count(*) FILTER (WHERE label <> 'benign') AS \"Attack flows\"\nFROM flows WHERE $__timeFilter(ts)\nGROUP BY src ORDER BY count(DISTINCT dport) DESC, count(*) DESC LIMIT 12"
        }
      ]
    }
  ],
  "templating": {
    "list": []
