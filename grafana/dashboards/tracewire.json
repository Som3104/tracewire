          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t AS \"Time\", engine AS \"Engine\", rule AS \"Rule\", name AS \"Detection\", severity AS \"Severity\",\n  src AS \"Source\", dst AS \"Target\", flows AS \"Flows\", truth AS \"Ground truth\", verdict AS \"Verdict\"\nFROM events WHERE $__timeFilter(t) ORDER BY t"
        }
      ],
      "fieldConfig": {
