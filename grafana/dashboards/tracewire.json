    {
      "id": 7,
      "type": "table",
      "title": "Detector scores (flow level)",
      "description": "",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "tracewire-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT engine AS \"Engine\", precision AS \"Precision\", recall AS \"Recall\", f1 AS \"F1\", fpr AS \"False-positive rate\",\n  tp AS \"TP\", fp AS \"FP\", fn AS \"FN\"\nFROM scores ORDER BY f1 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "False-positive rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "TP|FP|FN"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "F1"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2c93c0"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Time to detect, per attack episode",
      "description": "Seconds from the attack's first packet to the engine's first detection.",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "tracewire-db"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT attack AS \"Attack\",\n  max(CASE WHEN engine = 'Tracewire rules' THEN CASE WHEN detected THEN to_char(latency_s, 'FM990.0') || ' s' ELSE 'missed' END END) AS \"Tracewire rules\",\n  max(CASE WHEN engine = 'Suricata' THEN CASE WHEN detected THEN to_char(latency_s, 'FM990.0') || ' s' ELSE 'missed' END END) AS \"Suricata\",\n  max(CASE WHEN engine = 'Random forest' THEN CASE WHEN detected THEN to_char(latency_s, 'FM990.0') || ' s' ELSE 'missed' END END) AS \"Random forest\",\n  max(CASE WHEN engine = 'Isolation forest' THEN CASE WHEN detected THEN to_char(latency_s, 'FM990.0') || ' s' ELSE 'missed' END END) AS \"Isolation forest\"\nFROM episodes GROUP BY attack ORDER BY min(start_ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "missed": {
                  "color": "#b8326a",
                  "index": 0
                }
              }
            }
          ],
          "custom": {
            "cellOptions": {
              "type": "color-text"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Event ledger",
      "description": "",
      "datasource": {
        "uid": "tracewire-db"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
