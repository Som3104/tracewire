  "annotations": {
    "list": [
      {
        "name": "Attack episodes",
        "enable": true,
        "iconColor": "#b8326a",
        "datasource": {
          "uid": "tracewire-db"
        },
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (episode) start_ts AS time, attack || ' by ' || attacker AS text, 'episode' AS tags\nFROM episodes WHERE $__timeFilter(start_ts) ORDER BY episode"
        }
      }
    ]
  }
